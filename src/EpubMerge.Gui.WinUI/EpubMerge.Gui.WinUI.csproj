<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <AssemblyName>EpubMerge.Gui.WinUI</AssemblyName>
        <RootNamespace>EpubMerge.Gui.WinUI</RootNamespace>
        <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
        <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
        <UseWinUI>true</UseWinUI>
        <WindowsPackageType Condition="'$(StorePackage)' != 'true'">None</WindowsPackageType>
        <WindowsPackageType Condition="'$(StorePackage)' == 'true'">MSIX</WindowsPackageType>
        <EnableMsixTooling>true</EnableMsixTooling>
        <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
        <WinUISDKReferences>false</WinUISDKReferences>
        <Platforms>x64;ARM64</Platforms>
        <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
        <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
        <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
        <DefaultItemExcludes>$(DefaultItemExcludes);bin\**;obj\**</DefaultItemExcludes>
    </PropertyGroup>
    <PropertyGroup Condition="'$(StorePackage)' == 'true'">
        <SelfContained>true</SelfContained>
        <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
        <PublishSingleFile>false</PublishSingleFile>
        <PublishTrimmed Condition="'$(PublishAot)' != 'true'">false</PublishTrimmed>
        <GenerateAppxPackageOnBuild>true</GenerateAppxPackageOnBuild>
        <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
        <AppxAutoIncrementPackageRevision>false</AppxAutoIncrementPackageRevision>
        <AppxBundle>Never</AppxBundle>
        <UapAppxPackageBuildMode>StoreUpload</UapAppxPackageBuildMode>
    </PropertyGroup>
    <ItemGroup Condition="'$(StorePackage)' == 'true'">
        <AppxManifest Include="$(StoreManifestPath)" />
        <Content Include="Assets\Store\*.png" />
    </ItemGroup>
    <Target Name="ValidateStoreManifest" BeforeTargets="PrepareForBuild" Condition="'$(StorePackage)' == 'true'">
        <Error Condition="'$(StoreManifestPath)' == '' or !Exists('$(StoreManifestPath)')"
               Text="Build Store packages using publish-store.ps1, which validates the identity and generates the manifest." />
    </Target>
    <Target Name="RemoveNativeAotHostMetadata" AfterTargets="GetPackagingOutputs" BeforeTargets="_ComputeAppxPackagePayload"
            Condition="'$(StorePackage)' == 'true' and '$(PublishAot)' == 'true'">
        <ItemGroup>
            <PackagingOutputs Remove="@(PackagingOutputs)"
                              Condition="'%(PackagingOutputs.TargetPath)' == '$(AssemblyName).runtimeconfig.json' or '%(PackagingOutputs.TargetPath)' == '$(AssemblyName).deps.json'" />
        </ItemGroup>
    </Target>
    <ItemGroup>
        <ProjectReference Include="..\EpubMerge.Presentation\EpubMerge.Presentation.csproj" />
        <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
        <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.9457" />
        <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
</Project>
