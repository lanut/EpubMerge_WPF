<!-- ReSharper disable once MarkupAttributeTypo -->
<Window x:Class="EpubMerge.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:EpubMerge.Gui"
        xmlns:i18n="clr-namespace:Antelcat.I18N.WPF;assembly=Antelcat.I18N.WPF"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
        Title="{i18n:I18N {x:Static local:LangKeys.WindowTitle}}" Width="1200" Height="800" MinWidth="760"
        MinHeight="540"
        Background="Transparent" Icon="/EpubMerge.Gui;component/Assets/AppIcon.ico" 
        d:DataContext="{d:DesignInstance Type=local:MainViewModel, IsDesignTimeCreatable=True}">
    <Window.Resources>
        <local:MergeProgressStateConverter x:Key="MergeProgressStateConverter" />
    </Window.Resources>
    <Window.TaskbarItemInfo>
        <shell:TaskbarItemInfo
            ProgressState="{Binding ProgressState, Converter={StaticResource MergeProgressStateConverter}}"
            ProgressValue="{Binding ProgressValue}" />
    </Window.TaskbarItemInfo>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="420" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="250" MinWidth="210" />
        </Grid.ColumnDefinitions>
        <DockPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,18">
            <Grid DockPanel.Dock="Right" Margin="18,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="140" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{i18n:I18N {x:Static local:LangKeys.Theme}}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,5" />
                    <StackPanel Orientation="Horizontal" Width="Auto">
                        <Button Content="{i18n:I18N {x:Static local:LangKeys.System}}" Tag="System"
                                Click="ThemeModeButton_Click" Margin="0 0 8 0" />
                        <Button Content="{i18n:I18N {x:Static local:LangKeys.Light}}" Tag="Light"
                                Click="ThemeModeButton_Click" Margin="0 0 8 0" />
                        <Button Content="{i18n:I18N {x:Static local:LangKeys.Dark}}" Tag="Dark"
                                Click="ThemeModeButton_Click" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock Text="{i18n:I18N {x:Static local:LangKeys.LanguageLabel}}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,5" />
                    <ComboBox ItemsSource="{x:Static local:LanguageManager.Languages}" DisplayMemberPath="DisplayName"
                              SelectedValuePath="CultureName" SelectedValue="{Binding SelectedLanguage, Mode=TwoWay}" />
                </StackPanel>
            </Grid>
            <StackPanel>
                <TextBlock Text="{i18n:I18N {x:Static local:LangKeys.WindowTitle}}" FontSize="26" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="{i18n:I18N {x:Static local:LangKeys.Subtitle}}" Margin="0,6,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8"
                Padding="12"
                Margin="0,0,8,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <Border DockPanel.Dock="Right" Background="{DynamicResource AccentFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorOnAccentDefaultBrush}" BorderThickness="1"
                            CornerRadius="10"
                            Padding="8,2">
                        <TextBlock Text="{Binding FileCountText}"
                                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                   FontSize="12" />
                    </Border>
                    <TextBlock Text="{i18n:I18N {x:Static local:LangKeys.InputEpub}}" FontWeight="SemiBold"
                               FontSize="16" />
                </DockPanel>
                <Grid Grid.Row="1" Margin="0,10">
                    <ListView x:Name="FilesList" ItemsSource="{Binding Files}" IsEnabled="{Binding CanEdit}"
                              SelectionMode="Extended" SelectionChanged="FilesList_SelectionChanged" AllowDrop="True"
                              Drop="FilesList_Drop" DragOver="FilesList_DragOver"
                              MouseDoubleClick="FilesList_MouseDoubleClick"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{i18n:I18N {x:Static local:LangKeys.SetCoverFromBook}}"
                                          Command="{Binding PlacementTarget.DataContext.SetCoverFromSelectedBookCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="{i18n:I18N {x:Static local:LangKeys.ExportCover}}"
                                          Click="ExportBookCover_Click" />
                                <Separator />
                                <MenuItem Header="{i18n:I18N {x:Static local:LangKeys.LocateInExplorer}}"
                                          Click="LocateBook_Click" />
                                <MenuItem Header="{i18n:I18N {x:Static local:LangKeys.OpenWithDefault}}"
                                          Click="OpenBook_Click" />
                                <Separator />
                                <MenuItem Header="{i18n:I18N {x:Static local:LangKeys.MoveTop}}"
                                          Command="{Binding PlacementTarget.DataContext.MoveSelectedFilesToTopCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="{i18n:I18N {x:Static local:LangKeys.MoveBottom}}"
                                          Command="{Binding PlacementTarget.DataContext.MoveSelectedFilesToBottomCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="{i18n:I18N {x:Static local:LangKeys.MoveUp}}"
                                          Command="{Binding PlacementTarget.DataContext.MoveSelectedFilesUpCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="{i18n:I18N {x:Static local:LangKeys.MoveDown}}"
                                          Command="{Binding PlacementTarget.DataContext.MoveSelectedFilesDownCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="{i18n:I18N {x:Static local:LangKeys.RemoveSelected}}"
                                          Command="{Binding PlacementTarget.DataContext.RemoveSelectedFilesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            </ContextMenu>
                        </ListView.ContextMenu>
                        <ListView.View>
                            <GridView AllowsColumnReorder="False">
                                <GridViewColumn Header="{i18n:I18N {x:Static local:LangKeys.FileName}}"
                                                DisplayMemberBinding="{Binding Name}" Width="260" />
                                <GridViewColumn Header="{i18n:I18N {x:Static local:LangKeys.FullPath}}"
                                                DisplayMemberBinding="{Binding Path}" Width="560" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsHitTestVisible="False" Panel.ZIndex="1">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Files.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{i18n:I18N {x:Static local:LangKeys.DropEpub}}" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="14" />
                        <TextBlock Text="{i18n:I18N {x:Static local:LangKeys.AddFilesHint}}"
                                   HorizontalAlignment="Center" Margin="0,5,0,0"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12" />
                    </StackPanel>
                </Grid>
                <WrapPanel Grid.Row="2">
                    <Button Content="{i18n:I18N {x:Static local:LangKeys.AddFiles}}" IsEnabled="{Binding CanEdit}"
                            Background="{DynamicResource SystemFillColorSuccessBrush}"
                            Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                            Click="AddFiles_Click" Margin="0 0 8 0" />
                    <Button Content="{i18n:I18N {x:Static local:LangKeys.AddFolder}}" IsEnabled="{Binding CanEdit}"
                            Click="AddFolder_Click" Margin="0 0 8 0" />
                    <Button Content="{i18n:I18N {x:Static local:LangKeys.Remove}}"
                            Background="{DynamicResource SystemFillColorCriticalBrush}"
                            Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                            Command="{Binding RemoveSelectedFilesCommand}" Margin="0 0 8 0" />
                    <Button Content="{i18n:I18N {x:Static local:LangKeys.MoveUp}}"
                            Command="{Binding MoveSelectedFilesUpCommand}" Margin="0 0 8 0" />
                    <Button Content="{i18n:I18N {x:Static local:LangKeys.MoveDown}}"
                            Command="{Binding MoveSelectedFilesDownCommand}" Margin="0 0 8 0" />
                    <Button Content="{i18n:I18N {x:Static local:LangKeys.Clear}}" IsEnabled="{Binding CanEdit}"
                            Background="{DynamicResource SystemFillColorCautionBrush}"
                            Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                            Command="{Binding ClearFilesCommand}" Margin="0 0 8 0" />
                </WrapPanel>
            </Grid>
        </Border>
        <GridSplitter Grid.Row="1" Grid.Column="1"
                      ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="False"
                      Panel.ZIndex="10" Cursor="SizeWE" />
        <Border Grid.Row="1" Grid.Column="2" Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8"
                Padding="16"
                Margin="8,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{i18n:I18N {x:Static local:LangKeys.MergeSettings}}" FontWeight="SemiBold"
                           FontSize="16" Margin="0,0,0,12"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Grid.Row="1" Text="{i18n:I18N {x:Static local:LangKeys.OutputFile}}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <Grid Grid.Row="2" Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding CanEdit}" Margin="0,0,8,0" />
                    <Button Grid.Column="1" Content="{i18n:I18N {x:Static local:LangKeys.ChooseLocation}}"
                            IsEnabled="{Binding CanEdit}" Click="PickOutput_Click" />
                </Grid>
                <StackPanel Grid.Row="3" Margin="0,14,0,0">
                    <TextBlock Text="{i18n:I18N {x:Static local:LangKeys.MergeTitle}}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}"
                             Margin="0,5,0,0" />
                </StackPanel>
                <Grid Grid.Row="4" Margin="0,16,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{i18n:I18N {x:Static local:LangKeys.CoverPreview}}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Border x:Name="CoverPreviewBorder" Grid.Row="1" Margin="0,7,0,0" MinHeight="120"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="6"
                            AllowDrop="True" DragOver="CoverPreview_DragOver" Drop="CoverPreview_Drop">
                        <Grid>
                            <Image Source="{Binding CoverPreviewPath}" Stretch="Uniform" Margin="8" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="1">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CoverPreviewPath}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="▧" FontSize="34"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding CoverPreviewMessage}"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,6,0,0"
                                           TextAlignment="Center" TextWrapping="Wrap" />
                                <TextBlock Text="{i18n:I18N {x:Static local:LangKeys.DropImageHint}}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,8,0,0" TextAlignment="Center" />
                                <TextBlock Text="{i18n:I18N {x:Static local:LangKeys.ExistingCoverHint}}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,8,0,0" TextAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock Grid.Row="2" Text="{Binding CoverPreviewStatus}"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12" Margin="0,6,0,0" />
                </Grid>
                <StackPanel Grid.Row="5">
                    <TextBlock Text="{i18n:I18N {x:Static local:LangKeys.CoverPath}}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBox Text="{Binding CoverPath, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding CanEdit}" Margin="0,5,0,6" />
                    <WrapPanel>
                        <Button Content="{i18n:I18N {x:Static local:LangKeys.ChooseCover}}"
                                IsEnabled="{Binding CanEdit}" Click="PickCover_Click" Margin="0,0,8,0" />
                        <Button Content="{i18n:I18N {x:Static local:LangKeys.Clear}}"
                                Background="{DynamicResource SystemFillColorCriticalBrush}"
                                Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                Command="{Binding ClearCoverCommand}" Margin="0,0,8,0" />
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="2" Grid.ColumnSpan="3" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar Height="8" Minimum="0" Maximum="{Binding ProgressTotal}"
                             Value="{Binding ProgressCompleted}" VerticalAlignment="Center"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Grid.Column="1" Text="{Binding ProgressCountText}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </Grid>
        <DockPanel Grid.Row="3" Grid.ColumnSpan="3" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Height="20" />
                <TextBlock Text="{i18n:I18N {x:Static local:LangKeys.SupportedFormats}}"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                    <Run Text="{i18n:I18N {x:Static local:LangKeys.Author}}" />
                    <Path Width="13" Height="13" Stretch="Uniform"
                          Fill="{DynamicResource TextFillColorTertiaryBrush}"
                          Data="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.757-1.333-1.757-1.089-.745.084-.729.084-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.108-.776.418-1.305.762-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.292-1.552 3.297-1.23 3.297-1.23.647 1.653.24 2.873.118 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.43.372.823 1.102.823 2.222 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.575C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
                    <Hyperlink NavigateUri="https://github.com/lanut/EpubMerge_WPF"
                               RequestNavigate="Hyperlink_RequestNavigate">
                        <Run Text="{i18n:I18N {x:Static local:LangKeys.GithubHome}}" />
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{i18n:I18N {x:Static local:LangKeys.History}}" Click="History_Click"
                        HorizontalAlignment="Left" Margin="0, 0,8,0" />
                <Button Content="{Binding MergeButtonText}"
                        Click="Merge_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>