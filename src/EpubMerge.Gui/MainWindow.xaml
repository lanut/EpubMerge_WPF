<Window x:Class="EpubMerge.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="EPUB 合并工具" Width="1200" Height="800" MinWidth="760" MinHeight="540"
        Background="Transparent" Icon="/EpubMerge.Gui;component/Assets/AppIcon.ico">
    <Window.TaskbarItemInfo>
        <shell:TaskbarItemInfo ProgressState="{Binding TaskbarProgressState}"
                               ProgressValue="{Binding ProgressValue}" />
    </Window.TaskbarItemInfo>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="420" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="250" MinWidth="210" />
        </Grid.ColumnDefinitions>
        <DockPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Right" Width="180" Margin="18,0,0,0">
                <TextBlock Text="主题" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,5" />
                <UniformGrid Columns="3">
                    <Button Content="系统" Tag="System" Click="ThemeModeButton_Click" />
                    <Button Content="浅色" Tag="Light" Click="ThemeModeButton_Click" />
                    <Button Content="深色" Tag="Dark" Click="ThemeModeButton_Click" />
                </UniformGrid>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="EPUB 合并工具" FontSize="26" FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="按列表顺序合并；每本源书会成为合并目录的一级项目。" Margin="0,6,0,0"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12"
                Margin="0,0,8,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <Border DockPanel.Dock="Right" Background="{DynamicResource AccentFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorOnAccentDefaultBrush}" BorderThickness="1" CornerRadius="10"
                            Padding="8,2">
                        <TextBlock Text="{Binding FileCountText}" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                   FontSize="12" />
                    </Border>
                    <TextBlock Text="输入 EPUB" FontWeight="SemiBold" FontSize="16" />
                </DockPanel>
                <Grid Grid.Row="1" Margin="0,10">
                    <ListView x:Name="FilesList" ItemsSource="{Binding Files}"
                              SelectionMode="Extended" SelectionChanged="FilesList_SelectionChanged" AllowDrop="True"
                              Drop="FilesList_Drop" DragOver="FilesList_DragOver"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.View>
                            <GridView AllowsColumnReorder="False">
                                <GridViewColumn Header="文件名" DisplayMemberBinding="{Binding Name}" Width="260" />
                                <GridViewColumn Header="完整路径" DisplayMemberBinding="{Binding Path}" Width="560" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsHitTestVisible="False" Panel.ZIndex="1">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Files.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="将 EPUB 文件拖放到此处" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="14" />
                        <TextBlock Text="也可以使用下方按钮添加文件" HorizontalAlignment="Center" Margin="0,5,0,0"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12" />
                    </StackPanel>
                </Grid>
                <WrapPanel Grid.Row="2">
                    <Button Content="添加文件" Background="{DynamicResource SystemFillColorSuccessBrush}"
                            Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                            Click="AddFiles_Click" Margin="0 0 8 0"/>
                    <Button x:Name="RemoveButton" Content="移除"
                            Background="{DynamicResource SystemFillColorCriticalBrush}"
                            Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                            IsEnabled="False" Click="Remove_Click" Margin="0 0 8 0"/>
                    <Button x:Name="MoveUpButton" Content="上移"
                            IsEnabled="False" Click="MoveUp_Click" Margin="0 0 8 0"/>
                    <Button x:Name="MoveDownButton" Content="下移"
                            IsEnabled="False" Click="MoveDown_Click" Margin="0 0 8 0"/>
                    <Button Content="清空" Background="{DynamicResource SystemFillColorCautionBrush}"
                            Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                            Click="Clear_Click" Margin="0 0 8 0"/>
                </WrapPanel>
            </Grid>
        </Border>
        <GridSplitter Grid.Row="1" Grid.Column="1"
                      ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="False"
                      Panel.ZIndex="10" Cursor="SizeWE" />
        <Border Grid.Row="1" Grid.Column="2" Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16"
                Margin="8,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="合并设置" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Grid.Row="1" Text="输出文件" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <Grid Grid.Row="2" Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                    <Button Grid.Column="1" Content="选择位置" Click="PickOutput_Click" />
                </Grid>
                <StackPanel Grid.Row="3" Margin="0,14,0,0">
                    <TextBlock Text="合并书名" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0" />
                </StackPanel>
                <Grid Grid.Row="4" Margin="0,16,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="封面预览" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Border x:Name="CoverPreviewBorder" Grid.Row="1" Margin="0,7,0,0" MinHeight="120"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6"
                            AllowDrop="True" DragOver="CoverPreview_DragOver" Drop="CoverPreview_Drop">
                        <Grid>
                            <Image Source="{Binding CoverPreview}" Stretch="Uniform" Margin="8" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="1">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CoverPreview}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="▧" FontSize="34" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding CoverPreviewMessage}"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,6,0,0"
                                           TextAlignment="Center" TextWrapping="Wrap" />
                                <TextBlock Text="支持拖放图片进行预览" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,8,0,0" TextAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock Grid.Row="2" Text="{Binding CoverPreviewStatus}"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12" Margin="0,6,0,0" />
                </Grid>
                <StackPanel Grid.Row="5">
                    <TextBlock Text="封面图片路径" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBox Text="{Binding CoverPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,6" />
                    <WrapPanel>
                        <Button Content="选择封面" Click="PickCover_Click" Margin="0,0,8,0" />
                        <Button Content="清除" Background="{DynamicResource SystemFillColorCriticalBrush}"
                                Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                Click="ClearCover_Click" Margin="0,0,8,0" />
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="2" Grid.ColumnSpan="3" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar Height="8" Minimum="0" Maximum="{Binding ProgressTotal}"
                             Value="{Binding ProgressCompleted}" VerticalAlignment="Center"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Grid.Column="1" Text="{Binding ProgressCountText}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </Grid>
        <DockPanel Grid.Row="3" Grid.ColumnSpan="3" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Height="20" />
                <TextBlock Text="支持 EPUB 2 / EPUB 3，封面支持 JPG、PNG、GIF、WEBP、SVG。"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                    <Run Text="作者：lanut | " />
                    <Path Width="13" Height="13" Stretch="Uniform"
                          Fill="{DynamicResource TextFillColorTertiaryBrush}"
                          Data="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.757-1.333-1.757-1.089-.745.084-.729.084-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.108-.776.418-1.305.762-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.292-1.552 3.297-1.23 3.297-1.23.647 1.653.24 2.873.118 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.43.372.823 1.102.823 2.222 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.575C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
                    <Hyperlink NavigateUri="https://github.com/lanut/EpubMerge_WPF"
                               RequestNavigate="Hyperlink_RequestNavigate">
                        <Run Text=" GitHub 项目主页" />
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
            <Button x:Name="MergeButton" DockPanel.Dock="Right" Content="开始合并" Click="Merge_Click" />
        </DockPanel>
    </Grid>
</Window>
